{
  "$schema": "node_modules/wrangler/config-schema.json",
  // No environments and no production values here: the host's build variables decide those (see vite.config.ts).
  //   VITE_API_URL  the API's public URL, used by the browser (and by the server when there is no binding)
  //   API_WORKER    the API Worker's name, bound as `API` for server-side requests
  // With neither set the site runs on its own, from the illustrations bundled with it.
  "name": "wobli",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts"
}
