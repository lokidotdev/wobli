{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"],
      "wobli": ["./src/vendor/wobli/index.ts"],
      "wobli/react": ["./src/vendor/wobli/Sticker.tsx"],
      "wobli/icons/*": ["./src/vendor/wobli/icons/*.ts"],
      "wobli-api/contracts": ["./src/vendor/contracts.ts"]
    }
  }
}
