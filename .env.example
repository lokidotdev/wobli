# The site's build variables. All optional: with none set the site runs on its own, from the illustrations bundled
# with it. Set them on the host (Cloudflare Workers Builds → Settings → Build → Variables and secrets), the way you
# would on Vercel. Locally you need none of them: `pnpm dev` talks to the local backend on http://localhost:8787.
# They are read at build time, so change them and rebuild. To try them locally, copy to .env.production and run
# `pnpm build && pnpm preview`.

# The API's public URL. The browser calls it (and the server too when API_WORKER isn't set).
# Leave unset until the domain actually points at the API Worker.
VITE_API_URL=https://api.wobli.space

# The API Worker's name, bound as `API` so server-side rendering calls it directly (no network hop, no rate limit).
# It must be the name the backend is deployed under (backend WORKER_NAME), and that Worker must exist before the first
# build that sets this, or Cloudflare refuses the deploy.
API_WORKER=wobli-api
